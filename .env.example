# --- ZORUNLU ---
# Google Cloud Console > APIs & Services > Credentials > API key ("YouTube Data API v3" etkin olmalı)
YOUTUBE_API_KEY=

# --- OPSİYONEL ---
# Reddit: reddit.com/prefs/apps > "script" tipi app (anonim erişim 403 verir)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube Analytics (izlenme süresi, izlenme yüzdesi, abone kazancı): OAuth istemcisi (Desktop app)
# Doldurduktan sonra: pnpm yt-auth <kanal-id>
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# Instagram/TikTok metrikleri için yt-dlp'nin çerez okuyacağı tarayıcı (o tarayıcıda oturum açık olmalı)
YTDLP_COOKIES_BROWSER=chrome

LOOKBACK_HOURS=168
PER_QUERY=25
